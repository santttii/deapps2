# URL del backend (WildFly). Si no se define, el frontend usa http://localhost:8080.
# Para cambiarla, copiar este archivo como .env y reiniciar "npm run dev".
# El backend solo acepta pedidos desde los orígenes de PALCO_CORS_ORIGENES
# (por defecto http://localhost:5173).
VITE_API_URL=http://localhost:8080
