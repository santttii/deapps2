+  comprobar(`${nombre}: 200 con ETag y, con If-None-Match, 304 sin cuerpo`,
+    r.status === 200 && Boolean(etag) && segundo.status === 304 && cuerpo === '', `${r.status} ${etag} → ${segundo.status}`);
+  return etag;
+}
