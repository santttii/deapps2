<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.palco</groupId>
    <artifactId>palco-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Palco: backend</name>

    <modules>
        <module>common</module>
        <module>servicios</module>
        <module>servidor</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <version.jakartaee>11.0.0</version.jakartaee>
        <version.wildfly>41.0.1.Final</version.wildfly>
        <version.wildfly.plugin>6.0.1.Final</version.wildfly.plugin>
        <version.wildfly.datasources>11.5.0.Final</version.wildfly.datasources>
        <version.flyway>13.9.0</version.flyway>
        <version.microprofile.jwt>2.2</version.microprofile.jwt>
        <version.microprofile.config>3.1.1</version.microprofile.config>
        <version.junit>6.1.3</version.junit>
        <version.mockito>5.24.0</version.mockito>
        <version.yasson>3.0.5</version.yasson>
        <!-- Implementación de Jakarta Mail (el envío de emails). La API viene en la plataforma y la
             implementación la trae WildFly: acá solo se usa en los tests, para armar un MimeMessage
             sin servidor, igual que yasson con JSON-B. -->
        <version.angus.mail>2.0.4</version.angus.mail>
        <!-- SOAP (Facturación y el ARCA simulado). La API la pone WildFly con la capa "webservices";
             Metro (la implementación de referencia) solo se usa en los tests, para publicar y
             llamar un servicio SOAP sin servidor. -->
        <version.jakarta.xml.ws>4.0.2</version.jakarta.xml.ws>
        <version.metro>4.0.3</version.metro>
        <!-- Pruebas de integración contra un PostgreSQL de verdad (los *IT de los servicios, ver
             maven-failsafe-plugin abajo): Testcontainers levanta en Docker la misma imagen que usa el
             docker-compose, y el driver es el que trae el datasource de WildFly
             (wildfly-datasources-galleon-pack 11.5.0.Final usa el 42.7.13). -->
        <version.testcontainers>2.0.5</version.testcontainers>
        <version.postgresql>42.7.13</version.postgresql>
        <!-- El broker que trae WildFly 41 (ActiveMQ Artemis 2.54.0): el IT del consumidor de Facturación levanta
             esa versión en un contenedor (apache/artemis:2.54.0) y le habla con su cliente JMS. -->
        <version.artemis>2.54.0</version.artemis>

        <version.compiler.plugin>3.16.0</version.compiler.plugin>
        <version.surefire.plugin>3.6.0</version.surefire.plugin>
        <version.jacoco.plugin>0.8.16</version.jacoco.plugin>
        <version.war.plugin>3.5.1</version.war.plugin>
        <version.dependency.plugin>3.11.0</version.dependency.plugin>
        <!-- Trae PMD 7.17.0, que ya entiende el código de Java 25 -->
        <version.pmd.plugin>3.28.0</version.pmd.plugin>
        <!-- PIT (pruebas de mutación) y su plugin para correr los tests de la plataforma JUnit: con estas
             versiones lee las clases de Java 25 y corre los tests de JUnit 6. -->
        <version.pitest.plugin>1.30.2</version.pitest.plugin>
        <version.pitest.junit5>1.2.3</version.pitest.junit5>

        <!-- Qué muta PIT, cuánto tiene que matar y con cuántos hilos (ver el plugin en pluginManagement).
             Se cambian con -D sin tocar el pom: -Dmutacion.clases=com.palco.*.negocio.* mide el negocio
             aparte. -->
        <mutacion.clases>com.palco.*.dominio.*</mutacion.clases>
        <mutacion.minimo>60</mutacion.minimo>
        <mutacion.hilos>2</mutacion.hilos>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${version.jakartaee}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.microprofile.jwt</groupId>
                <artifactId>microprofile-jwt-auth-api</artifactId>
                <version>${version.microprofile.jwt}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <!-- Lectura de configuración (ConfigProvider). WildFly ya la trae: por eso "provided". -->
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${version.microprofile.config}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.palco</groupId>
                <artifactId>palco-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${version.flyway}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${version.flyway}</version>
            </dependency>
            <dependency>
                <!-- Implementación de Jakarta Mail para los tests (en WildFly ya viene incluida) -->
                <groupId>org.eclipse.angus</groupId>
                <artifactId>angus-mail</artifactId>
                <version>${version.angus.mail}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Implementación de JSON-B para los tests (en WildFly ya viene incluida) -->
                <groupId>org.eclipse</groupId>
                <artifactId>yasson</artifactId>
                <version>${version.yasson}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${version.junit}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Jakarta XML Web Services (JAX-WS): no está en la API de Jakarta EE 11. "provided": la trae WildFly. -->
                <groupId>jakarta.xml.ws</groupId>
                <artifactId>jakarta.xml.ws-api</artifactId>
                <version>${version.jakarta.xml.ws}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <!-- Implementación de JAX-WS para los tests (Endpoint.publish con el servidor HTTP del JDK). -->
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-rt</artifactId>
                <version>${version.metro}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Dobles de prueba con Mockito.mock(...). No se usa mockito-junit-jupiter: arrastra JUnit 5. -->
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${version.mockito}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- PostgreSQL en un contenedor para los *IT. Solo en los tests: el WAR no lo lleva. -->
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-postgresql</artifactId>
                <version>${version.testcontainers}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Driver JDBC de PostgreSQL para los *IT. En el servidor lo pone WildFly. -->
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${version.postgresql}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Cliente JMS de Artemis para los *IT que publican y consumen contra el broker en un
                     contenedor. En el servidor lo pone WildFly. -->
                <groupId>org.apache.artemis</groupId>
                <artifactId>artemis-jakarta-client</artifactId>
                <version>${version.artemis}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${version.compiler.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.surefire.plugin}</version>
                </plugin>
                <!-- Pruebas de integración con dependencias reales: las clases *IT de src/test, que corren los
                     tests de los repositorios contra PostgreSQL 17 en un contenedor (Testcontainers) en lugar de
                     H2, y el consumidor de Facturación contra Artemis 2.54.0 (el broker de WildFly 41), también
                     en un contenedor. Surefire no las toma (busca *Test); las corre failsafe en "mvn verify",
                     después de los tests unitarios, y si alguna falla el build falla. Lo usa cada módulo que
                     tiene IT nombrándolo en su pom (Usuarios, Eventos, Ventas, Notificaciones y Facturación).

                     La JVM de los IT arranca con -Dpalco.pruebas.integracion=true, y cada IT corre solo con esa
                     marca (@EnabledIfSystemProperty). Así no los corre PIT, que toma todas las clases de test del
                     módulo: levantaría un contenedor por cada mutante que pasa por un repositorio o por el MDB.
                     Como el argLine es propio, tampoco llevan el agente de JaCoCo: la cobertura informada sigue
                     siendo la de los tests de surefire. Sin Docker, cada IT se saltea con un aviso (ver los *IT);
                     el CI comprueba que no se haya salteado ninguno.

                     Para correrlos solos, desde backend/ y con palco-common instalado (mvn install):
                       mvn verify -pl servicios/ventas -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <!-- Sale junto con surefire, con la misma versión -->
                    <version>${version.surefire.plugin}</version>
                    <configuration>
                        <!-- Las clases compiladas y no el WAR: en el WAR están en WEB-INF/classes y no se pueden
                             usar como classpath. Failsafe 3.6.0 ya toma el artefacto solo si es un .jar; queda
                             escrito para no depender de eso. -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <argLine>-Dpalco.pruebas.integracion=true</argLine>
                    </configuration>
                    <executions>
                        <execution>
                            <id>integracion-con-dependencias-reales</id>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${version.war.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${version.dependency.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.wildfly.plugins</groupId>
                    <artifactId>wildfly-maven-plugin</artifactId>
                    <version>${version.wildfly.plugin}</version>
                </plugin>
                <!-- Pruebas de mutación (PIT). PIT cambia una cosa por vez en el código compilado (invierte
                     una condición, borra una llamada, cambia lo que devuelve un método) y vuelve a correr los
                     tests que pasan por esa línea. Si alguno falla, el mutante murió; si todos pasan,
                     sobrevivió: la línea se ejecuta en los tests pero ninguno controla lo que hace.

                     No está en <plugins>, así que no corre en "mvn verify": se pide aparte, y lo hace
                     .github/workflows/mutacion.yml. Para correrlo a mano en un servicio, desde backend/ y con
                     palco-common ya instalado (mvn install):
                       mvn test-compile org.pitest:pitest-maven:mutationCoverage -pl servicios/ventas
                     El reporte queda en target/pit-reports (index.html y mutations.xml).
                     En Windows, la ruta de la carpeta del repo no puede tener tildes ni eñes (por ejemplo, una
                     carpeta "Programación" en el camino): con una así, el proceso en el que PIT corre los tests
                     no encuentra las clases del módulo, no corre ninguno y el puntaje sale 0 %. El CI corre en
                     Linux y no tiene ese problema.

                     Se muta el paquete de dominio de cada servicio, que es lo que mide la cátedra, y si quedan
                     muertos menos del 60 % de sus mutantes el módulo falla. Los tests que corren son todos los
                     del módulo y no solo los de ese paquete: una regla de una entidad también la controla un
                     test del negocio. Un módulo sin paquete de dominio (common, el asistente, el ARCA
                     simulado) no tiene nada que mutar: PIT no corre sus tests y el módulo no falla por eso. -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${version.pitest.plugin}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${version.pitest.junit5}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>${mutacion.clases}</param>
                        </targetClasses>
                        <targetTests>
                            <param>com.palco.*</param>
                        </targetTests>
                        <mutationThreshold>${mutacion.minimo}</mutationThreshold>
                        <failWhenNoMutations>false</failWhenNoMutations>
                        <threads>${mutacion.hilos}</threads>
                        <outputFormats>
                            <param>HTML</param>
                            <param>XML</param>
                        </outputFormats>
                        <!-- Siempre en target/pit-reports, sin una carpeta por fecha: así el CI sabe dónde buscarlo -->
                        <timestampedReports>false</timestampedReports>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Cobertura de los tests (JaCoCo): el agente se engancha a surefire y en "verify" deja el
                 reporte de cada módulo en target/site/jacoco (HTML, XML y CSV). El CI los sube como
                 artefacto y scripts/qa/cobertura.mjs arma el resumen. Después del reporte controla el umbral
                 de la capa de negocio y dominio (ver la ejecución "umbral-de-negocio-y-dominio"). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${version.jacoco.plugin}</version>
                <executions>
                    <execution>
                        <id>agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Cada corrida reemplaza el target/jacoco.exec de la anterior. Por defecto el
                                 agente le suma lo nuevo, y un "mvn verify" sin "clean" mezclaría en el reporte
                                 y en el umbral lo que cubrieron tests de corridas viejas, que quizás ya no
                                 existen. En el CI la carpeta target arranca vacía y da lo mismo. -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Umbral de cobertura del plan de pruebas (sección 4) y del eje B de los criterios de la
                         cátedra: en la capa de negocio y dominio de cada módulo, al menos el 80 % de las líneas y
                         el 70 % de las ramas cubiertas por los tests. Corre en "verify", después del reporte: si
                         un módulo queda debajo, "mvn verify" falla en ese módulo y dice qué porcentaje midió, y
                         el job "Backend" del CI queda en rojo. El reporte ya quedó escrito, así que se ve qué
                         bajó.

                         Qué se mide: las clases de los paquetes negocio y dominio de cada servicio (dominio con
                         dominio.estado, el patrón State de la venta), sumadas en un solo total por módulo
                         (BUNDLE). El total es por módulo y no por paquete porque los dominios tienen muy pocas
                         ramas: los de Notificaciones y Reventa, ninguna, y los otros, de dos a poco más de diez.
                         Con tan pocas, una sola sin cubrir (por ejemplo, el null de un conversor de JPA) le saca
                         25 puntos al paquete, y la lógica que usa las entidades está en negocio, que entra en el
                         mismo total. Un total sin ramas no tiene porcentaje de ramas: JaCoCo no lo cuenta como
                         debajo del umbral.

                         Qué no entra: negocio.externos, los adaptadores hacia afuera del servicio (los clientes
                         REST de los otros servicios de Palco y el simulador de cobros de Ventas, el cliente SOAP
                         de ARCA, el almacén de imágenes y el modelo de lenguaje del asistente). Arman el pedido,
                         lo mandan y traducen la respuesta. Tienen sus propios tests, que cambian el otro sistema
                         por respuestas preparadas (o, en ArcaSoapTest, por un servicio SOAP de prueba), y la
                         llamada de verdad entre servicios la hacen los escenarios de integración del CI; su
                         cobertura sigue en el reporte y en el resumen del CI, sin umbral.
                         En Eventos el paquete tiene además TiposDeImagen, la regla de qué imágenes aceptan los
                         almacenes: queda afuera con el resto del paquete y la prueba TiposDeImagenTest. Tampoco
                         entran api y datos (la capa REST y los repositorios, que prueban los tests con H2 y los
                         *IT) ni common.

                         Los módulos sin negocio ni dominio (common y el ARCA simulado) no tienen nada que medir:
                         con el total vacío no hay porcentaje que comparar y el módulo no falla. Sin
                         target/jacoco.exec (con -DskipTests, como en el Dockerfile y en mutacion.yml) JaCoCo
                         saltea el control con un aviso. Se mide lo que cubren los tests de surefire: los *IT
                         corren sin el agente (ver maven-failsafe-plugin). -->
                    <execution>
                        <id>umbral-de-negocio-y-dominio</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/negocio/**</include>
                                <include>**/dominio/**</include>
                            </includes>
                            <excludes>
                                <exclude>**/negocio/externos/**</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Análisis estático (PMD) del código de src/main/java de cada módulo, con "quickstart": el
                 conjunto de reglas que PMD recomienda para empezar. En "verify" deja target/pmd.xml y
                 target/reports/pmd.html; el CI los sube como artefacto y scripts/qa/analisis-estatico.mjs
                 arma el resumen. Los hallazgos se informan pero no cortan el build, así se corrigen de a
                 poco. Lo que sí lo corta es que PMD no pueda analizar el código (skipPmdError en false):
                 un archivo que no entiende o una versión de Java que no conoce no puede quedar en verde. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${version.pmd.plugin}</version>
                <configuration>
                    <!-- Sin esto PMD toma maven.compiler.source, que acá no está: se compila con release -->
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <rulesets>
                        <ruleset>rulesets/java/quickstart.xml</ruleset>
                    </rulesets>
                    <failOnViolation>false</failOnViolation>
                    <skipPmdError>false</skipPmdError>
                    <!-- El reporte HTML no enlaza al código fuente (no se genera el sitio con JXR) -->
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>analisis-estatico</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
