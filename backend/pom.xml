<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.palco</groupId>
    <artifactId>palco-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Palco — backend</name>

    <modules>
        <module>common</module>
        <module>servicios</module>
        <module>servidor</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <version.jakartaee>11.0.0</version.jakartaee>
        <version.wildfly>41.0.1.Final</version.wildfly>
        <version.wildfly.plugin>6.0.1.Final</version.wildfly.plugin>
        <version.wildfly.datasources>11.5.0.Final</version.wildfly.datasources>
        <version.flyway>13.9.0</version.flyway>
        <version.microprofile.jwt>2.2</version.microprofile.jwt>
        <version.microprofile.config>3.1.1</version.microprofile.config>
        <version.junit>6.1.3</version.junit>
        <version.mockito>5.24.0</version.mockito>
        <version.yasson>3.0.5</version.yasson>
        <!-- SOAP (Facturación y el ARCA simulado). La API la pone WildFly con la capa "webservices";
             Metro (la implementación de referencia) solo se usa en los tests, para publicar y
             llamar un servicio SOAP sin servidor. -->
        <version.jakarta.xml.ws>4.0.2</version.jakarta.xml.ws>
        <version.metro>4.0.3</version.metro>

        <version.compiler.plugin>3.16.0</version.compiler.plugin>
        <version.surefire.plugin>3.6.0</version.surefire.plugin>
        <version.war.plugin>3.5.1</version.war.plugin>
        <version.dependency.plugin>3.11.0</version.dependency.plugin>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${version.jakartaee}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.microprofile.jwt</groupId>
                <artifactId>microprofile-jwt-auth-api</artifactId>
                <version>${version.microprofile.jwt}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <!-- Lectura de configuración (ConfigProvider). WildFly ya la trae: por eso "provided". -->
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${version.microprofile.config}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.palco</groupId>
                <artifactId>palco-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${version.flyway}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${version.flyway}</version>
            </dependency>
            <dependency>
                <!-- Implementación de JSON-B para los tests (en WildFly ya viene incluida) -->
                <groupId>org.eclipse</groupId>
                <artifactId>yasson</artifactId>
                <version>${version.yasson}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${version.junit}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Jakarta XML Web Services (JAX-WS): no está en la API de Jakarta EE 11. "provided": la trae WildFly. -->
                <groupId>jakarta.xml.ws</groupId>
                <artifactId>jakarta.xml.ws-api</artifactId>
                <version>${version.jakarta.xml.ws}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <!-- Implementación de JAX-WS para los tests (Endpoint.publish con el servidor HTTP del JDK). -->
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-rt</artifactId>
                <version>${version.metro}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- Dobles de prueba con Mockito.mock(...). No se usa mockito-junit-jupiter: arrastra JUnit 5. -->
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${version.mockito}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${version.compiler.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.surefire.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${version.war.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${version.dependency.plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.wildfly.plugins</groupId>
                    <artifactId>wildfly-maven-plugin</artifactId>
                    <version>${version.wildfly.plugin}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
