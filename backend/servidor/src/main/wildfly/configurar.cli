# Configuración de WildFly versionada, así todo el grupo y el hosting tienen el mismo setup.
#
# OJO: este script corre una sola vez, cuando Maven arma el servidor en
# servidor/target/server. Si esa carpeta ya existe, el armado se saltea y los cambios
# de este archivo NO se aplican. Para tomar un cambio hay dos caminos:
#   a) Aplicar las mismas líneas al servidor en marcha con bin/jboss-cli (con NOPAUSE=true
#      en Windows). Las de reintentos se aplican así, sin reiniciar: están en docs/notas/mensajeria.md.
#   b) Detener WildFly y rearmar con "mvn clean install". Borra los mensajes guardados
#      del broker, y con la base H2 en memoria también los datos. Nunca "clean" con WildFly levantado.

# --- Base de datos -------------------------------------------------------------
# Por defecto: H2 en memoria, en modo compatible con PostgreSQL (desarrollo).
# Para Supabase: definir PALCO_DB_DRIVER=postgresql, PALCO_DB_URL,
# PALCO_DB_USUARIO y PALCO_DB_PASSWORD. Los servicios no cambian.
data-source add --name=PalcoDS \
    --jndi-name=java:jboss/datasources/PalcoDS \
    --driver-name=${env.PALCO_DB_DRIVER:h2} \
    --connection-url=${env.PALCO_DB_URL:jdbc:h2:mem:palco;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH} \
    --user-name=${env.PALCO_DB_USUARIO:sa} \
    --password=${env.PALCO_DB_PASSWORD:sa} \
    --min-pool-size=0 \
    --max-pool-size=10 \
    --validate-on-match=true \
    --background-validation=false

# --- Mensajería (taller "Escenario de mensajería") ------------------------------
# Punto a punto: un único consumidor emite las entradas después del pago.
jms-queue add --queue-address=cola.emision-entradas --entries=["java:/jms/queue/emisionEntradas"]

# Publicación/suscripción: Notificaciones y Auditoría reciben cada una su copia.
jms-topic add --topic-address=topico.compra-confirmada --entries=["java:/jms/topic/compraConfirmada"]

# Reintentos: un mensaje que falla se entrega hasta 5 veces, con 2 segundos entre una y
# otra, y después pasa a la cola de mensajes fallidos (DLQ, java:/jms/queue/DLQ), que ya
# viene configurada. Vale para todas las colas y suscripciones ("#" es "cualquier dirección").
# De fábrica son 10 entregas seguidas, sin espera: una falla pasajera (la base que tarda
# en responder) agotaría los intentos en un instante.
/subsystem=messaging-activemq/server=default/address-setting=#:write-attribute(name=max-delivery-attempts,value=5)
/subsystem=messaging-activemq/server=default/address-setting=#:write-attribute(name=redelivery-delay,value=2000)

# --- Seguridad -------------------------------------------------------------------
# Hace que @RolesAllowed / @PermitAll funcionen en los recursos REST de todos los
# servicios. Los roles salen del token JWT (claim "groups").
/subsystem=jaxrs:write-attribute(name=resteasy-role-based-security, value=true)
