<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.palco</groupId>
        <artifactId>palco-servicios</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>palco-usuarios</artifactId>
    <packaging>war</packaging>
    <name>Palco — ServicioDeUsuarios</name>
    <description>Registro, autenticación y roles (comprador, organizador, staff). Interfaz: IUsuarios.</description>

    <dependencies>
        <dependency>
            <!-- Dobles de prueba de lo que en producción pone el servidor: el EntityManager y las
                 claves JWT. Versión y alcance (test) vienen del pom padre. -->
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <!-- Para MigracionesEnH2Test y RepositoriosEnH2Test: corre las migraciones sobre la misma base que usa
                 WildFly en desarrollo (H2 en modo PostgreSQL). En el servidor H2 lo pone WildFly,
                 por eso no viaja en el WAR. Misma versión que trae el servidor. -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Solo para RepositoriosEnH2Test: corre las consultas de los repositorios con Hibernate
                 contra H2. En el servidor Hibernate lo pone WildFly. Misma versión que trae WildFly 41. -->
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.4.5.Final</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>usuarios</finalName>
    </build>
</project>
