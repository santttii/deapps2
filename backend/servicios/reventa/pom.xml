<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.palco</groupId>
        <artifactId>palco-servicios</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>palco-reventa</artifactId>
    <packaging>war</packaging>
    <name>Palco — ServicioDeReventa</name>
    <description>Publicación y compra de reventa oficial con tope de precio. Interfaz: IReventa.</description>

    <dependencies>
        <dependency>
            <!-- Dobles de prueba de los clientes REST y del repositorio: el negocio se testea sin servidor.
                 La versión y el alcance (test) vienen del pom padre. -->
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <!-- Solo para PublicacionesEnH2Test: corre la migración y los UPDATE condicionales contra H2
                 en modo PostgreSQL, la base de WildFly en desarrollo. En el servidor H2 e Hibernate los
                 pone WildFly, por eso no viajan en el WAR. Mismas versiones que trae WildFly 41. -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.4.5.Final</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>reventa</finalName>
    </build>
</project>
