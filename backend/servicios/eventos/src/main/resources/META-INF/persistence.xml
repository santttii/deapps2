<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="eventos" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/PalcoDS</jta-data-source>
        <properties>
            <!-- Las tablas las crea Flyway (db/migracion), nunca Hibernate -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.default_schema" value="eventos"/>
        </properties>
    </persistence-unit>
</persistence>
