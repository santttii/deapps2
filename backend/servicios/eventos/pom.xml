<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.palco</groupId>
        <artifactId>palco-servicios</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>palco-eventos</artifactId>
    <packaging>war</packaging>
    <name>Palco — ServicioDeEventos</name>
    <description>Catálogo de eventos, tipos de entrada y cupos. Interfaz: IEventos.</description>

    <dependencies>
        <dependency>
            <!-- Dobles de prueba de los repositorios: los tests del negocio corren sin servidor ni base.
                 Versión y alcance (test) vienen del pom padre. -->
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <!-- Solo para CupoEnH2Test: corre las consultas y el UPDATE condicional del cupo contra H2
                 en modo PostgreSQL, la base de WildFly en desarrollo. En el servidor H2 e Hibernate los
                 pone WildFly, por eso no viajan en el WAR. Mismas versiones que trae WildFly 41. -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.4.5.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Solo para NuevoEventoDtoTest: valida las anotaciones del DTO como lo hace el servidor
                 con @Valid. Hibernate Validator necesita un intérprete de expresiones (Expressly) para
                 armar los mensajes. En el servidor los dos los pone WildFly. -->
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>9.1.1.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>6.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>eventos</finalName>
    </build>
</project>
