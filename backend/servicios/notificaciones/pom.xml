<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.palco</groupId>
        <artifactId>palco-servicios</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>palco-notificaciones</artifactId>
    <packaging>war</packaging>
    <name>Palco — ServicioDeNotificaciones</name>
    <description>Confirmaciones, recordatorios y alertas, de forma asincrónica. Interfaz: INotificaciones.</description>

    <dependencies>
        <dependency>
            <!-- Dobles de prueba de lo que en producción pone el servidor: el mensaje JMS, el
                 contexto del MDB y el EntityManager. Versión y alcance (test) vienen del pom padre. -->
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <!-- Solo para MigracionesEnH2Test: corre las migraciones sobre la misma base que usa
                 WildFly en desarrollo (H2 en modo PostgreSQL). En el servidor H2 lo pone WildFly,
                 por eso no viaja en el WAR. Misma versión que trae el servidor. -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>notificaciones</finalName>
    </build>
</project>
