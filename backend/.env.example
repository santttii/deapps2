# Copiá este archivo a .env y completá los valores. El .env NO se sube al repo.
# dev.sh lo carga solo.

# Orígenes que pueden llamar a la API (separados por coma)
PALCO_CORS_ORIGENES=http://localhost:5173

# --- Base de datos ---------------------------------------------------------------
# Sin estas variables se usa H2 en memoria (se borra al reiniciar, y las
# migraciones vuelven a cargar los datos de prueba).
#
# Para usar Supabase: Connect → Session pooler, descomentar y completar.
# PALCO_DB_DRIVER=postgresql
# PALCO_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# PALCO_DB_USUARIO=postgres.xxxxxxxx
# PALCO_DB_PASSWORD=

# --- Sesiones (tokens JWT) ---------------------------------------------------------
# Clave con la que ServicioDeUsuarios firma los tokens. Sin ella se genera una
# nueva en cada arranque (hay que volver a iniciar sesión). Para producción:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt -outform DER | base64
# PALCO_JWT_CLAVE_PRIVADA=

# Dirección donde los servicios encuentran a ServicioDeUsuarios para validar
# tokens. Solo cambia si los servicios corren en servidores distintos.
# PALCO_URL_INTERNA=http://localhost:8080

# --- Llamadas entre servicios --------------------------------------------------------
# Secreto que comparten los 8 servicios. Con él, un servicio le pide a
# ServicioDeUsuarios un token de rol "servicio" (POST /api/usuarios/servicios/token)
# para llamar a otro: Ventas a Eventos y a Pagos. Sin esta variable vale
# "palco-desarrollo", que es público, y el log lo avisa al arrancar. En producción
# hay que definirlo, con el mismo valor para todos los servicios.
# PALCO_SECRETO_SERVICIOS=

# --- Pagos -----------------------------------------------------------------------------
# Con qué pasarela cobra ServicioDePagos. Hoy el único valor posible es "fake", el
# simulador (tok_rechazado rechaza, tok_sin_respuesta no contesta y cualquier otro
# token aprueba), y es el valor por defecto. Un valor que no existe se rechaza con
# un error que nombra los posibles. Mercado Pago está diseñado, pendiente.
# PALCO_PAGOS_PROVEEDOR=fake

# Quién cobra cuando se paga una compra en ServicioDeVentas. Por defecto "pagos":
# Ventas llama por REST a ServicioDePagos. Con "fake" usa un simulador propio y no
# queda ningún pago guardado: sirve solo para trabajar en Ventas sin Pagos desplegado.
# PALCO_VENTAS_COBROS=pagos
