# Copiá este archivo a .env y completá los valores. El .env NO se sube al repo.
# dev.sh lo carga solo.

# Orígenes que pueden llamar a la API (separados por coma)
PALCO_CORS_ORIGENES=http://localhost:5173

# --- Base de datos ---------------------------------------------------------------
# Sin estas variables se usa H2 en memoria (se borra al reiniciar, y las
# migraciones vuelven a cargar los datos de prueba).
#
# Para usar Supabase: Connect → Session pooler, descomentar y completar.
# PALCO_DB_DRIVER=postgresql
# PALCO_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# PALCO_DB_USUARIO=postgres.xxxxxxxx
# PALCO_DB_PASSWORD=
